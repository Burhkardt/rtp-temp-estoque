SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Configurações de Banco de Dados
LOCAL_DB_USER=admin
LOCAL_DB_PASSWORD=your_password
LOCAL_DB_NAME=local_auth_db
LOCAL_DB_PORT=5432

REMOTE_DB_USER=readonly_user
REMOTE_DB_PASSWORD=your_readonly_password
REMOTE_DB_NAME=remote_data_db
REMOTE_DB_PORT=5433

# Configurações do Backend
BACKEND_PORT=8000
LOCAL_DATABASE_URL=postgresql://admin:password@db:5432/local_auth_db
REMOTE_DATABASE_URL=postgresql://readonly_user:password@remote_db:5432/remote_data_db

# Configurações de Mensageria (WhatsApp/Twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Configurações do Frontend
FRONTEND_PORT=3000
API_URL=http://localhost:8000